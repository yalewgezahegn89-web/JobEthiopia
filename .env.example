DATABASE_URL="postgresql://user:password@localhost:5432/jobethiopia"

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# Public HTTPS origin (e.g. https://jobs.example.com). REQUIRED for
# production — it is used for CSRF origin validation, sitemap/robots,
# metadataBase, and password-reset/email links. On Vercel this must be a
# BUILD-TIME environment variable (metadataBase/sitemap/robots are evaluated
# at build time). In production the app FAILS FAST if it is missing/blank —
# there is no localhost fallback. Local development falls back to
# http://localhost:3000.
APP_BASE_URL="http://localhost:3000"

# Header name overwritten by a trusted reverse proxy with the real client IP
# (e.g. "x-real-ip"). REQUIRED for correct per-client rate limiting behind
# Vercel/proxy. This is OPT-IN: arbitrary client-supplied x-forwarded-for is
# NEVER trusted by default. Configure ONLY a platform/proxy-controlled header
# and verify the chosen header behavior before launch. If unset, every client
# shares one rate-limit bucket (127.0.0.1 fallback).
TRUSTED_CLIENT_IP_HEADER=""

# API key required to call the job ingestion endpoints (x-api-key header).
INGESTION_API_KEY="change-me"

# API key required to call the maintenance run endpoint (x-maintenance-key header).
MAINTENANCE_API_KEY="change-me"

# ---------------------------------------------------------------------------
# RECOMMENDED / FEATURE-REQUIRED (degradations if unset)
# ---------------------------------------------------------------------------

# Email (Resend). Without RESEND_API_KEY + EMAIL_FROM email stays a no-op:
# password-reset tokens are created but no email is sent, and application
# status/submission notifications are silently skipped.
RESEND_API_KEY=
EMAIL_FROM=
# Optional:
# EMAIL_REPLY_TO=

# Resume storage (S3/R2 private bucket). Missing config is NOT fatal: resume
# upload/delete/download return neutral 503/500 while the rest of the app
# works normally.
RESUME_STORAGE_ENDPOINT=""
RESUME_STORAGE_REGION="auto"
RESUME_STORAGE_BUCKET=""
RESUME_STORAGE_ACCESS_KEY_ID=""
RESUME_STORAGE_SECRET_ACCESS_KEY=""
# Optional: set "true" for path-style providers (e.g. MinIO).
# RESUME_STORAGE_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# OPTIONAL / TUNABLE
# ---------------------------------------------------------------------------

# PostgreSQL connection pool (Batch 98). All optional; sensible defaults are
# used when unset. Local development needs no changes.
# PG_CONNECTION_TIMEOUT_MS="10000"
# PG_POOL_MAX="10"
# PG_IDLE_TIMEOUT_MS="30000"
# SSL is enabled automatically in production (default CA verification) unless:
# (a) PG_DISABLE_SSL=true is set, or
# (b) the DATABASE_URL itself declares an sslmode=... query parameter.
# PG_DISABLE_SSL="false"

# ---------------------------------------------------------------------------
# DEVELOPMENT / STAGING ONLY — phone OTP delivery (NEVER PRODUCTION)
# ---------------------------------------------------------------------------
#
# The phone OTP system is complete but has no SMS provider wired up yet, so by
# default the generated code is stored and never delivered — the browser flow
# cannot complete. To verify the flow in a non-production environment, set:
#   PHONE_OTP_DEV_DELIVERY=log
#
# When enabled, the phone server action prints the OTP code to the SERVER log
# (clearly prefixed `[phone-otp-dev]`) so it can be entered in the UI.
#
# SECURITY:
#   - This is HARD-GUARDED to non-production: it is only active when
#     NODE_ENV !== "production" AND PHONE_OTP_DEV_DELIVERY=log are BOTH set.
#   - In production this flag is IGNORED; no plaintext OTP is ever logged and
#     the code is never returned to clients. Leave it unset or blank in
#     production.
#   - Never set this in the Vercel production environment.
# PHONE_OTP_DEV_DELIVERY=""

# ---------------------------------------------------------------------------
# BOOTSTRAP ONLY (used only by `npx tsx src/db/bootstrapAdmin.ts`)
# ---------------------------------------------------------------------------

# Create a SUPER_ADMIN on bootstrap. Idempotent; never read at app startup.
# The password is hashed with scrypt and never printed.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
