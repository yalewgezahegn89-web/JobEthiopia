DATABASE_URL="postgresql://user:password@localhost:5432/jobethiopia"

# Optional: trusted client-IP header for rate limiting (Batch 63).
# Default (header unset): every client shares one rate-limit bucket because the
# raw connection IP is not observable from middleware. Set this to a single
# header name ONLY if a trusted reverse proxy sanitizes/overwrites it with the
# real client IP (e.g. "x-real-ip"). It is never enabled by header presence:
# arbitrary x-forwarded-for is NOT trusted and never read by default.
# If unset, the shared 127.0.0.1 fallback bucket is used.
TRUSTED_CLIENT_IP_HEADER=""
INGESTION_API_KEY="change-me"
MAINTENANCE_API_KEY="change-me"
APP_BASE_URL="http://localhost:3000"

# Optional: create a SUPER_ADMIN on `npx tsx src/db/bootstrapAdmin.ts`.
# The bootstrap is idempotent; the password is hashed with scrypt and never printed.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Email (Batch 83): live transactional email via Resend.
# Without these, email remains a no-op (password reset tokens are created but
# no email is sent, and application-status notifications are silently skipped).
RESEND_API_KEY=
EMAIL_FROM=
# Optional:
# EMAIL_REPLY_TO=

# Resume storage (Batch 89): per-application PDF resume upload via S3-compatible
# private bucket (Amazon S3, Cloudflare R2, etc.). Missing config is NOT fatal:
# resume upload/delete/download endpoints return neutral 503/500 while the rest
# of the app works normally.
RESUME_STORAGE_ENDPOINT=""
RESUME_STORAGE_REGION="auto"
RESUME_STORAGE_BUCKET=""
RESUME_STORAGE_ACCESS_KEY_ID=""
RESUME_STORAGE_SECRET_ACCESS_KEY=""
# Optional: set to "true" for S3-compatible providers that require path-style
# access (e.g. MinIO). Not needed for AWS S3 or Cloudflare R2.
# RESUME_STORAGE_FORCE_PATH_STYLE=false
